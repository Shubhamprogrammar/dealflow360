{
  "info": {
    "name": "DealFlow360 API v1.0.0",
    "description": "Quote-to-cash backend. Staff routes use bearer auth; customer portal routes issue a separate token type that staff routes reject.\n\nGenerated from the OpenAPI spec by `npm run postman` — edit the route JSDoc, not this file.\n\nRun \"Staff login\" first: it stores accessToken, which every secured request sends automatically. Ids captured from create and list responses (productId, priceListId, userId, variantId) feed the path variables of later requests.\n\nAll responses are wrapped as { success, message, data, pagination? }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Staff and customer authentication",
      "item": [
        {
          "name": "Create an internal user (admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Create an internal user (admin only)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"priya@dealflow.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\",\n  \"team\": \"West\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.data && (body.data._id || body.data.id);",
                  "if (id) pm.collectionVariables.set('userId', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Staff login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dealflow.com\",\n  \"password\": \"dealflow\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.data.refreshToken || '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Exchange a refresh token for a new access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Exchange a refresh token for a new access token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "The currently signed-in staff user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "The currently signed-in staff user"
          },
          "response": []
        },
        {
          "name": "Client-side logout (tokens are stateless and are not revoked)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Client-side logout (tokens are stateless and are not revoked)",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Email a customer a one-time portal link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/customer/magic-link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "customer",
                "magic-link"
              ]
            },
            "description": "Email a customer a one-time portal link\n\nAlways returns 202, including for unknown emails, so the endpoint cannot be used to enumerate customers.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@acme.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Redeem a magic-link token for a customer session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/customer/verify/:token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "customer",
                "verify",
                ":token"
              ],
              "variable": [
                {
                  "key": "token",
                  "value": "{{magicLinkToken}}"
                }
              ]
            },
            "description": "Redeem a magic-link token for a customer session\n\nSingle use. The stored token is cleared on success, so replaying it returns 401.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) pm.collectionVariables.set('customerToken', body.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer portal password login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "customer",
                "login"
              ]
            },
            "description": "Customer portal password login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@acme.com\",\n  \"password\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) pm.collectionVariables.set('customerToken', body.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
