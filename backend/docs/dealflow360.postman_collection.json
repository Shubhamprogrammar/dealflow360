          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "hardware",
                  "disabled": true
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Case-insensitive name match",
                  "disabled": true
                }
              ]
            },
            "description": "List products, paginated"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const first = (pm.response.json().data || [])[0];",
                  "if (first && first._id) pm.collectionVariables.set('productId', first._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a product (admin, sales_manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Create a product (admin, sales_manager)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"category\": \"hardware\",\n  \"basePrice\": 1200,\n  \"costPrice\": 800,\n  \"unit\": \"unit\",\n  \"taxRate\": 0.1,\n  \"description\": \"string\",\n  \"maxDiscountByCategory\": 0,\n  \"isSubscription\": true,\n  \"variants\": [\n    {\n      \"attributeName\": \"Size\",\n      \"attributeValue\": \"Large\",\n      \"priceAdjustment\": 50\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const id = body.data && (body.data._id || body.data.id);",
                  "if (id) pm.collectionVariables.set('productId', id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch one product, including deactivated ones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            },
            "description": "Fetch one product, including deactivated ones"
          },
          "response": []
        },
        {
          "name": "Partially update a product (admin, sales_manager)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            },
            "description": "Partially update a product (admin, sales_manager)\n\nSend only changed fields; at least one is required. The pricing check runs against the merged product.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"category\": \"hardware\",\n  \"basePrice\": 1200,\n  \"costPrice\": 800,\n  \"unit\": \"unit\",\n  \"taxRate\": 0.1,\n  \"description\": \"string\",\n  \"maxDiscountByCategory\": 0,\n  \"isSubscription\": true,\n  \"variants\": [\n    {\n      \"attributeName\": \"Size\",\n      \"attributeValue\": \"Large\",\n      \"priceAdjustment\": 50\n    }\n  ],\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Deactivate a product (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            },
            "description": "Deactivate a product (soft delete)\n\nSets isActive to false. Quotations and orders reference products, so records are never destroyed."
          },
          "response": []
        },
        {
          "name": "Add a variant (admin, sales_manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/:id/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                ":id",
                "variants"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "{{productId}}"
                }
              ]
            },
            "description": "Add a variant (admin, sales_manager)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attributeName\": \"Size\",\n  \"attributeValue\": \"Large\",\n  \"priceAdjustment\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const variants = (body.data && body.data.variants) || [];",
                  "const last = variants[variants.length - 1];",
                  "if (last && last._id) pm.collectionVariables.set('variantId', last._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update one variant (admin, sales_manager)",
          "request": {
            "method": "PUT",
            "header": [
              {
