NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/backend_starter
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=replace-with-another-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_CUSTOMER_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DealFlow360 <no-reply@dealflow360.local>
PORTAL_BASE_URL=http://localhost:3000/portal
MAGIC_LINK_TTL_MINUTES=30
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-in-development
